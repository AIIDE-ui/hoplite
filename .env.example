# Server Configuration
# Default in code: HOST=127.0.0.1, PORT=3000
# Set HOST=0.0.0.0 if running inside a container or reverse-proxied environment.
HOST=127.0.0.1
PORT=3000

# SQLite Data Directory
# Default: data (creates data/bed-tracker.sqlite)
DATA_DIR=data

# Separate Admin Dashboard Credentials (stored hashed in SQLite on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Platform environment placeholders (managed by hosting environment if present)
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

